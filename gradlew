#!/bin/sh

#
# Gradle start up script for POSIX generated by Gradle.
#

# Resolve links: $0 may be a link
app_path=$0
while [ -h "$app_path" ]; do
    ls=$( ls -ld "$app_path" )
    link=${ls#*' -> '}
    case $link in
        /*) app_path=$link ;;
        *)  app_path=${app_path%/*}/$link ;;
    esac
done

APP_HOME=${app_path%"${app_path##*/}"}
APP_HOME=$( cd "${APP_HOME:-./}" && pwd -P ) || exit

DEFAULT_JVM_OPTS="-Xmx64m -Xms64m"

if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        JAVACMD=$JAVA_HOME/jre/sh/java
    else
        JAVACMD=$JAVA_HOME/bin/java
    fi
    if [ ! -x "$JAVACMD" ] ; then
        echo "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME" >&2
        exit 1
    fi
else
    JAVACMD=java
    command -v java >/dev/null 2>&1 || {
        echo "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
        exit 1
    }
fi

WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
WRAPPER_PROPS="$APP_HOME/gradle/wrapper/gradle-wrapper.properties"

if [ ! -f "$WRAPPER_JAR" ]; then
    mkdir -p "$APP_HOME/gradle/wrapper"
    if [ -f "/opt/gradle/gradle-9.3.1/lib/plugins/gradle-wrapper-main-9.3.1.jar" ]; then
        unzip -p "/opt/gradle/gradle-9.3.1/lib/plugins/gradle-wrapper-main-9.3.1.jar" gradle-wrapper.jar > "$WRAPPER_JAR" 2>/dev/null || true
    fi
    if [ ! -s "$WRAPPER_JAR" ] && [ -f "$WRAPPER_PROPS" ] && command -v curl >/dev/null 2>&1 && command -v unzip >/dev/null 2>&1; then
        DIST_URL=$(grep '^distributionUrl=' "$WRAPPER_PROPS" | cut -d'=' -f2- | sed 's/\\:/:/g' | tr -d '\r')
        if [ -n "$DIST_URL" ]; then
            TMP_ZIP=$(mktemp)
            TMP_DIR=$(mktemp -d)
            if curl -fsSL "$DIST_URL" -o "$TMP_ZIP"; then
                MAIN_JAR=$(unzip -Z1 "$TMP_ZIP" "*gradle-wrapper-main-*.jar" 2>/dev/null | head -n 1)
                if [ -n "$MAIN_JAR" ]; then
                    unzip -p "$TMP_ZIP" "$MAIN_JAR" > "$TMP_DIR/main.jar"
                    unzip -p "$TMP_DIR/main.jar" gradle-wrapper.jar > "$WRAPPER_JAR"
                fi
            fi
            rm -rf "$TMP_ZIP" "$TMP_DIR"
        fi
    fi
fi

if [ -s "$WRAPPER_JAR" ]; then
    exec "$JAVACMD" $DEFAULT_JVM_OPTS $JAVA_OPTS $GRADLE_OPTS "-Dorg.gradle.appname=gradlew" -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
elif command -v gradle >/dev/null 2>&1; then
    exec gradle "$@"
else
    echo "ERROR: Gradle wrapper JAR not found at $WRAPPER_JAR and system 'gradle' is not installed." >&2
    exit 1
fi
